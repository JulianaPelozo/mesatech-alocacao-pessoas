// schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}


model Funcionario {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  nomeFunc     String
  telefoneFunc String
  emailFunc    String
  disponivel   Boolean    @default(true) 
  @@map("funcionarios")
}



